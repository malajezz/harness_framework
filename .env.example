# TubeNext 환경변수 — 이 파일을 복사해 `.env.local`을 만들고 값을 채우세요.
# cp .env.example .env.local

# YouTube Data API v3 키
# 발급: Google Cloud Console > APIs & Services > "YouTube Data API v3" 사용 설정 > 사용자 인증 정보 > API 키
YOUTUBE_API_KEY=

# Claude(Anthropic) API 키
# 발급: https://console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
