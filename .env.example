# TubeNext 환경변수 — 이 파일을 복사해 `.env.local`을 만들고 값을 채우세요.
# cp .env.example .env.local

# YouTube Data API v3 키
# 발급: Google Cloud Console > APIs & Services > "YouTube Data API v3" 사용 설정 > 사용자 인증 정보 > API 키
YOUTUBE_API_KEY=

# Claude 인증: 별도 API 키가 필요 없습니다.
# @anthropic-ai/claude-agent-sdk가 이 기기의 Claude Code 자격증명(Pro/Max 구독)으로 인증합니다.
#   1) 이 기기에서 Claude Code에 구독 계정으로 로그인되어 있으면 그대로 동작
#   2) 또는 `claude setup-token`으로 장기 토큰을 만들어 환경에 CLAUDE_CODE_OAUTH_TOKEN 으로 설정
# 주의: ANTHROPIC_API_KEY를 설정하면 구독보다 우선되어 종량제로 과금됩니다 — 여기에 넣지 마세요.
